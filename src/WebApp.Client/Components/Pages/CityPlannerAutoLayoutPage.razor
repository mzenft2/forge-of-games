@attribute [Route(FogUrlBuilder.PageRoutes.CITY_PLANNER_AUTO_LAYOUT_PATH)]
@using Ingweland.Fog.Application.Client.Core.Localization
@using Ingweland.Fog.WebApp.Client.Components.Elements.CityPlanner
@using Ingweland.Fog.Application.Core.Helpers
@inherits Ingweland.Fog.WebApp.Client.Components.Pages.Abstractions.FogPageBase
<div class="component-root">
    <div class="fog-container auto-layout-container">
        <h5>@Loc[FogResource.CityPlanner_AutoLayout_Title]</h5>
        <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_Intro]</p>

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
        }
        else if (_cities.Count == 0)
        {
            <p>@Loc[FogResource.CityPlanner_AutoLayout_NoCities]</p>
        }
        else
        {
            <MudSelect T="string" Label="@Loc[FogResource.CityPlanner_AutoLayout_SourceCity]" Value="@_selectedCityId"
                       ValueChanged="OnCityChanged" Variant="Variant.Outlined" Dense="true" Disabled="@_isRunning">
                @foreach (var city in _cities)
                {
                    <MudSelectItem T="string" Value="@city.Id">@city.Name</MudSelectItem>
                }
            </MudSelect>
        }

        @if (_sourceCity != null)
        {
            <AutoLayoutFormComponent SourceCity="@_sourceCity" OnCityCreated="OpenCity"
                                     RunningChanged="v => _isRunning = v"/>
        }

        <p class="attribution">
            <a href="https://github.com/mzenft2/zenmar-strategy" target="_blank" rel="noopener">
                @Loc[FogResource.CityPlanner_AutoLayout_Attribution]
            </a>
        </p>
    </div>
</div>
