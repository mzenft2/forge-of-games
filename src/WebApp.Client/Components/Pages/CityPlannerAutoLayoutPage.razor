@attribute [Route(FogUrlBuilder.PageRoutes.CITY_PLANNER_AUTO_LAYOUT_PATH)]
@using Ingweland.Fog.Application.Client.Core.Localization
@using Ingweland.Fog.Application.Client.Web.CityPlanner.AutoLayout
@using Ingweland.Fog.Application.Core.Helpers
@inherits Ingweland.Fog.WebApp.Client.Components.Pages.Abstractions.FogPageBase
<div class="component-root">
    <div class="fog-container auto-layout-container">
        <h5>@Loc[FogResource.CityPlanner_AutoLayout_Title]</h5>
        <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_Intro]</p>

        @if (_isLoading)
        {
            <MudProgressLinear Color="Color.Primary" Indeterminate="true"/>
        }
        else if (_cities.Count == 0)
        {
            <p>@Loc[FogResource.CityPlanner_AutoLayout_NoCities]</p>
        }
        else
        {
            <MudSelect T="string" Label="@Loc[FogResource.CityPlanner_AutoLayout_SourceCity]" Value="@_selectedCityId"
                       ValueChanged="OnCityChanged" Variant="Variant.Outlined" Dense="true" Disabled="@_isRunning">
                @foreach (var city in _cities)
                {
                    <MudSelectItem T="string" Value="@city.Id">@city.Name</MudSelectItem>
                }
            </MudSelect>
        }

        @if (_settings != null && _catalog != null)
        {
            var era = SelectedEra;
            <fieldset disabled="@_isRunning">
                <div class="section">
                    <MudSelect T="string" Label="@Loc[FogResource.CityPlanner_AutoLayout_CityAge]"
                               Value="@_settings.EraId" ValueChanged="OnEraChanged" Variant="Variant.Outlined"
                               Dense="true">
                        @foreach (var e in _catalog.Eras)
                        {
                            <MudSelectItem T="string" Value="@e.Id">@e.Name</MudSelectItem>
                        }
                    </MudSelect>
                    <div class="land">
                        <span class="label">@string.Format(Loc[FogResource.CityPlanner_AutoLayout_Land_Summary], _settings.Tiles.Count(t => t))</span>
                        <div class="land-grid">
                            @for (var i = 0; i < _settings.Tiles.Length; i++)
                            {
                                <div class="land-cell @(_settings.Tiles[i] ? "open" : "")"></div>
                            }
                        </div>
                    </div>
                </div>

                <div class="section">
                    <h6>@Loc[FogResource.CityPlanner_AutoLayout_Keep]</h6>
                    @foreach (var (id, label) in OptionalBuildings)
                    {
                        <MudSwitch T="bool" Color="Color.Primary" Label="@label" Value="@GetOptional(id)"
                                   ValueChanged="v => SetOptional(id, v)"/>
                    }
                    @if (_settings.Tower)
                    {
                        <MudNumericField T="int" @bind-Value="_settings.TowerLevel" Min="1" Max="10"
                                         Label="@Loc[FogResource.CityPlanner_AutoLayout_TowerLevel]"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    }
                    @if (era.FountainLevels.Count > 0)
                    {
                        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_settings.Fountain"
                                   Label="@GetBuildingName(ZenmarCatalogFactory.FOUNTAIN_ID)"/>
                        @if (_settings.Fountain)
                        {
                            <MudNumericField T="int" @bind-Value="_settings.FountainLevel" Min="1" Max="50"
                                             Label="@Loc[FogResource.CityPlanner_AutoLayout_FountainLevel]"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        }
                    }
                    <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_Levels_Hint]</p>
                </div>

                <div class="section numbers">
                    <h6>@Loc[FogResource.CityPlanner_AutoLayout_OwnedPremium]</h6>
                    <MudNumericField T="int" @bind-Value="_settings.PremiumFarm" Min="0" Max="100"
                                     Label="@GetBuildingName("premiumFarm")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense"/>
                    <MudNumericField T="int" @bind-Value="_settings.PremiumHome" Min="0" Max="100"
                                     Label="@GetBuildingName("premiumHome")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense"/>
                    <MudNumericField T="int" @bind-Value="_settings.PremiumCulture" Min="0" Max="100"
                                     Label="@GetBuildingName("premiumCulture")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense"/>
                    <h6>@Loc[FogResource.CityPlanner_AutoLayout_OwnedFarms]</h6>
                    <MudNumericField T="int" @bind-Value="_settings.RuralFarms" Min="0" Max="80"
                                     Label="@GetBuildingName("ruralFarm")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense"/>
                    <MudNumericField T="int" @bind-Value="_settings.DomesticFarms" Min="0" Max="80"
                                     Label="@GetBuildingName("domesticFarm")" Variant="Variant.Outlined"
                                     Margin="Margin.Dense"/>
                </div>

                <div class="section numbers">
                    <h6>@Loc[FogResource.CityPlanner_AutoLayout_Schedule]</h6>
                    <MudNumericField T="double" @bind-Value="_settings.Interval" Min="0.25" Max="16" Step="0.25"
                                     Label="@($"{Loc[FogResource.CityPlanner_AutoLayout_DayInterval]} ({Loc[FogResource.Common_Hours_Abbr]})")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudNumericField T="double" @bind-Value="_settings.Night" Min="0" Max="16" Step="0.5"
                                     Label="@($"{Loc[FogResource.CityPlanner_AutoLayout_NightBreak]} ({Loc[FogResource.Common_Hours_Abbr]})")"
                                     Variant="Variant.Outlined" Margin="Margin.Dense"/>
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_settings.Subscription"
                               Label="@Loc[FogResource.CityPlanner_AutoLayout_DoubleStorage]"/>
                    <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_settings.FullArmy"
                               Label="@Loc[FogResource.CityPlanner_AutoLayout_BarracksMin]"/>
                </div>

                @if (era.Current.Count > 0)
                {
                    <div class="section numbers">
                        <h6>@Loc[FogResource.CityPlanner_AutoLayout_Workshops]</h6>
                        @foreach (var workshopId in era.Current)
                        {
                            <MudNumericField T="int" Value="@_settings.WorkshopCounts.GetValueOrDefault(workshopId)"
                                             ValueChanged="v => _settings.WorkshopCounts[workshopId] = v" Min="0"
                                             Max="20" Label="@GetBuildingName(workshopId)"
                                             Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        }
                        <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_Workshops_Hint]</p>
                    </div>
                }

                @if (era.OldWorkshop != null)
                {
                    <div class="section numbers">
                        <h6>@Loc[FogResource.CityPlanner_AutoLayout_Furnace]</h6>
                        <MudNumericField T="int" @bind-Value="_settings.OldCount" Min="0" Max="50"
                                         Label="@Loc[FogResource.CityPlanner_AutoLayout_OldWorkshops]"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        <MudNumericField T="int" @bind-Value="_settings.SparkCap" Min="0" Max="100000" Step="100"
                                         Label="@Loc[FogResource.CityPlanner_AutoLayout_FurnaceLimit]"
                                         Variant="Variant.Outlined" Margin="Margin.Dense"/>
                        <MudSwitch T="bool" Color="Color.Primary" @bind-Value="_settings.CompareSparks"
                                   Label="@Loc[FogResource.CityPlanner_AutoLayout_FurnaceVariant]"/>
                    </div>
                }

                <div class="section">
                    <MudSelect T="int" Label="@Loc[FogResource.CityPlanner_AutoLayout_SearchTime]"
                               @bind-Value="_settings.SearchSeconds" Variant="Variant.Outlined" Dense="true">
                        @foreach (var seconds in AutoLayoutSettings.SearchSecondsOptions)
                        {
                            <MudSelectItem T="int" Value="@seconds">@FormatSeconds(seconds)</MudSelectItem>
                        }
                    </MudSelect>
                    <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_SearchTime_Hint]</p>
                </div>
            </fieldset>

            <div class="actions">
                @if (_isRunning)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StopAsync">
                        @Loc[FogResource.CityPlanner_AutoLayout_Stop]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="CancelAsync">@Loc[FogResource.Common_Cancel]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RunAsync">
                        @Loc[FogResource.CityPlanner_AutoLayout_Run]
                    </MudButton>
                }
            </div>

            @if (_isRunning)
            {
                <MudProgressLinear Color="Color.Primary" Value="@_progress" Max="1"/>
                <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_Status_Searching]</p>
            }

            @if (_statusMessage != null)
            {
                <p class="status">@_statusMessage</p>
            }

            @if (_result != null)
            {
                <div class="section result">
                    <h6>@(_result.IsComplete ? Loc[FogResource.CityPlanner_AutoLayout_Result_Valid] : Loc[FogResource.CityPlanner_AutoLayout_Result_Draft])</h6>
                    <table>
                        <tr>
                            <td>@Loc[FogResource.CityPlanner_AutoLayout_Result_TotalValue]</td>
                            <td>@_result.TotalValue.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>@Loc[FogResource.CityPlanner_AutoLayout_Result_WorkersAvailable]</td>
                            <td>@_result.SpareWorkers.ToString("N0")</td>
                        </tr>
                        <tr>
                            <td>@Loc[FogResource.CityPlanner_AutoLayout_Result_FreeTiles]</td>
                            <td>@FreeTiles.ToString("N0")</td>
                        </tr>
                    </table>
                    @if (_result.ArmyDeficit)
                    {
                        <p class="status">@Loc[FogResource.CityPlanner_AutoLayout_Result_BarracksBelow]</p>
                    }
                    <p class="hint">@Loc[FogResource.CityPlanner_AutoLayout_Result_Scope]</p>
                    @if (!_isRunning)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAndOpenAsync">
                            @Loc[FogResource.CityPlanner_AutoLayout_SaveAndOpen]
                        </MudButton>
                    }
                </div>
            }
        }

        <p class="attribution">
            <a href="https://github.com/mzenft2/zenmar-strategy" target="_blank" rel="noopener">
                @Loc[FogResource.CityPlanner_AutoLayout_Attribution]
            </a>
        </p>
    </div>
</div>
